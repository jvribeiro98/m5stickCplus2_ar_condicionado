{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openir.dev/schemas/v1/compatibility.schema.json",
  "title": "OpenIR Compatibility",
  "description": "Relação direcional e baseada em evidência entre dois Devices.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target_device_id",
    "relation",
    "scope",
    "confidence",
    "evidence",
    "tested_commands",
    "tested_signals",
    "notes"
  ],
  "properties": {
    "target_device_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 160
    },
    "relation": {
      "enum": ["equivalent", "compatible", "subset", "superset", "family", "incompatible", "unknown"]
    },
    "scope": {
      "enum": ["full", "partial", "command_subset", "signal_subset", "unknown"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "description", "uri"],
        "properties": {
          "type": {"enum": ["device_test", "capture_comparison", "manufacturer", "community_report", "derived", "other"]},
          "description": {"type": "string", "minLength": 1, "maxLength": 1000},
          "uri": {"type": ["string", "null"], "format": "uri"}
        }
      },
      "minItems": 1
    },
    "tested_commands": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^binding-[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "tested_signals": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^signal-sha256-[a-f0-9]{64}$"
      },
      "uniqueItems": true
    },
    "notes": {
      "type": ["string", "null"],
      "maxLength": 2000
    },
    "tested_at": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"scope": {"const": "command_subset"}}, "required": ["scope"]},
      "then": {"properties": {"tested_commands": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"scope": {"const": "signal_subset"}}, "required": ["scope"]},
      "then": {"properties": {"tested_signals": {"minItems": 1}}}
    }
  ]
}
