{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openir.dev/schemas/v1/device.schema.json",
  "title": "OpenIR Device",
  "description": "Modelo ou família que declara Capabilities e Bindings, sem duplicar Signals globais.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "openir_version",
    "id",
    "category",
    "brand",
    "model",
    "aliases",
    "description",
    "year",
    "region",
    "manufacturer",
    "capabilities",
    "bindings",
    "state_model",
    "compatibility",
    "contributors",
    "source",
    "license",
    "status",
    "version",
    "extensions"
  ],
  "properties": {
    "openir_version": {"const": "1.0"},
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 160
    },
    "category": {"$ref": "category.schema.json"},
    "brand": {"$ref": "brand.schema.json"},
    "model": {"type": "string", "minLength": 1, "maxLength": 160},
    "aliases": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 200},
      "uniqueItems": true
    },
    "description": {"type": "string", "minLength": 1, "maxLength": 2000},
    "year": {"type": ["integer", "null"], "minimum": 1950, "maximum": 2200},
    "region": {
      "type": "array",
      "items": {
        "oneOf": [
          {"const": "global"},
          {"type": "string", "pattern": "^[A-Z]{2}$"}
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "manufacturer": {"type": "string", "minLength": 1, "maxLength": 200},
    "capabilities": {
      "type": "array",
      "items": {"$ref": "capability.schema.json"},
      "minItems": 1
    },
    "bindings": {
      "type": "array",
      "items": {"$ref": "binding.schema.json"},
      "minItems": 1
    },
    "state_model": {
      "oneOf": [
        {"$ref": "state-model.schema.json"},
        {"type": "null"}
      ]
    },
    "compatibility": {
      "type": "array",
      "items": {"$ref": "compatibility.schema.json"}
    },
    "contributors": {
      "type": "array",
      "items": {"$ref": "#/$defs/contributor"},
      "minItems": 1
    },
    "source": {"$ref": "#/$defs/source"},
    "license": {"$ref": "#/$defs/license"},
    "status": {"enum": ["draft", "experimental", "verified", "deprecated", "rejected"]},
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "supersedes": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^x-[a-z0-9]+(?:-[a-z0-9]+)+$"},
      "additionalProperties": true
    }
  },
  "$defs": {
    "contributor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "roles"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 120},
        "roles": {
          "type": "array",
          "items": {"enum": ["author", "tester", "reviewer", "maintainer"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "url": {"type": ["string", "null"], "format": "uri"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "references", "confidence"],
      "properties": {
        "origin": {
          "enum": ["manufacturer_documentation", "community_database", "reverse_engineering", "generated", "converted", "unknown"]
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["uri", "description", "hash"],
            "properties": {
              "uri": {"type": ["string", "null"], "format": "uri"},
              "description": {"type": "string", "minLength": 1, "maxLength": 1000},
              "hash": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"}
            }
          },
          "minItems": 1
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx_id", "name", "url"],
      "properties": {
        "spdx_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9.+-]+$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "url": {"type": ["string", "null"], "format": "uri"}
      }
    }
  }
}
