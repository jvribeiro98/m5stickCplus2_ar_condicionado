{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openir.dev/schemas/v1/brand.schema.json",
  "title": "OpenIR Brand",
  "description": "Identidade normalizada de uma marca, com nomes alternativos.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "display_name", "aliases"],
  "properties": {
    "id": {
      "$ref": "#/$defs/brandId"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "uniqueItems": true
    },
    "manufacturer": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 200
    },
    "website": {
      "type": ["string", "null"],
      "format": "uri"
    }
  },
  "$defs": {
    "brandId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 80
    }
  }
}
